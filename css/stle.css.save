/* tablet responsiveness */
 @media screen and (min-width: 481px) and (max-width: 768px) {
    .hero-image-container{
        display: none;
    }
    .hero{
        display: block;
    }
    .hero-text{
        width: 100%;
        text-align: center;
    }
    .hero h1{
        font-size: 45px;
        text-align: center;
    }
    .hamburger-container{
        display: flex;
        /* border: 2px solid white; */
        width: 40px;
        height: 40px;
        

    }
    
    .fa-solid{
        height: 30px;
        width: 30px;
        margin-left: 5px;
        margin-top: 25px;
        

    }
    
    .navigation-list{
        display: none;
    }
    .everything{
        display: flex;
        flex-direction: column;
        gap: 70px;
    }
    .summation{
        display: flex;
        flex-direction: column;
    }
    .last{
        display: flex;
        flex-direction: column;
        justify-content: center;
        justify-self: center;
    }
}

