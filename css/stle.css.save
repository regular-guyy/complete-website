body{ padding: 0px; margin: 0px; background-color: white;
}
header{
    width: 100vw;
    /* border: 2px
     solid blue; */
    color: white;
    background-color: black;

}
.navigation{
    /* border: 2px solid red; */
    margin: 0 auto;
    padding: 5px;

    width:80% ;
   
  display: flex;
  flex-direction: row; 
  justify-content: space-between; 
}
.navigation-list{
    display: flex;
    flex-direction: row;
    width: 50%;
    justify-content: space-between;
    
}
.navigation-list li{
    list-style-type: none;
}
main{
    width: 100vw;
    background-color: black
}
.hero{
    width: 80%;
    background-color: black;
    margin: 0 auto;
    padding-top: 100px;
    /* border: 2px solid blue;  */
    display: flex;
    margin-top: 0px;
    flex-direction: row;
    height: 75vh;
    /* color: white; */
    justify-content: space-between;

}
.hero-text{
    width: 50%;
}
.hamburger-container{
    display: none;
}
.hero h1{
    color: white;
    text-align: left;
    padding-top: 0px;
    padding-bottom: 0px;
    text-align: left;
    font-size: 50px;
    font-weight: 900;
}
.hero p{
    color: white;
    /* text-align: center; */
    font-size: 20px;
    

}
.hero-image-container{
  width: 45%;
  height: 85%;
  /* border: 2px solid red; */
  border-radius: 20px;
  overflow: hidden;
}
.hero-image{
    width: 100%;
    height: 100%;
    /* object-fit: contain; */
    /* border-radius: 50px; */
}
.btn{
    background-color: blue;
    color: white;
    padding: 10px;
    border-radius: 5px;
    width: 150px;
    height: 50px;
    font-size: 18px;
    /* ?background-color: aqua; */
    
}
.btn:hover{
    background-color: black;
}
.btn-secondary{
    margin-left: 20px;
    background-color: blue;
    color: white;
    padding: 10px;
    border-radius: 5px;
    width: 150px;
    height: 50px;
    font-size: 18px;
    
}
.bob{
    background-color: white;
    /* border: 2px solid blue; */
    
}
.everything{
    margin: 0 auto;
    width: 80%;
    background-color: white;
    color: black;
    /* border: 2px solid red; */
    display: flex;
    justify-content: center;
    align-content: center;
    


}
